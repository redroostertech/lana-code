---
interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro site" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --accent: #136399;
    --accent-light: #e0f2fe;
  }

  html {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #213547;
    background: #ffffff;
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }

  code {
    font-family: Menlo, Monaco, 'Lucida Console', 'Courier New', monospace;
  }
</style>
